{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BMatrix Calendario",
  "version": "1.0.5",
  "identifier": "com.bruno.calendario",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BMatrix Calendario",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: asset: https://asset.localhost; media-src 'self'; worker-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyRDBFMjE1OUMwMjREN0YKUldSL1RRS2NGZUxRRXZzVUtZWmFMVE5OOHdwcWFXMmI5YzY3WkFwajBnTFhVc3IvVVF3Wm9uWHkK",
      "endpoints": [
        "https://github.com/BrunoSugga/app-calendario/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
